; Link v1 control messages. A frame is a big-endian u32 length, then one CBOR envelope of at most 64 KiB.
; Types marked "0-RTT" are idempotent and may be sent in QUIC early data.

envelope = hello-msg / pair-spake-msg / pair-confirm-msg / unpair-msg / share-msg / share-ack-msg /
  notification-posted-msg / notification-removed-msg / notification-action-msg / notification-dismiss-msg /
  notification-snapshot-msg / notification-pull-msg /
  media-player-msg / media-gone-msg / media-command-msg / ring-msg / ringing-msg / call-msg / call-action-msg /
  hotspot-request-msg / hotspot-msg / hotspot-joined-msg / hotspot-end-msg / punch-msg /
  wifi-direct-ready-msg / wifi-direct-msg / bt-pairing-msg /
  mirror-request-msg / mirror-started-msg / screen-shape-msg / mirror-stop-msg / mirror-input-msg /
  mirror-keyframe-msg / mirror-data-msg /
  fs-list-msg / fs-entries-msg / fs-read-msg / fs-data-msg / fs-error-msg / fs-stat-msg / fs-thumb-msg /
  fs-write-msg / fs-delete-msg / photo-request-msg / photo-taken-msg /
  contacts-list-msg / contacts-msg / contacts-changed-msg /
  texts-list-msg / texts-msg / texts-changed-msg / text-send-msg / text-sent-msg /
  calls-list-msg / calls-msg / calls-changed-msg / dial-msg / dialed-msg /
  remote-input-msg / remote-request-msg / remote-started-msg / remote-stop-msg / commands-msg / run-command-msg / ping-msg / presenting-msg / capabilities-msg / desktop-status-msg / system-command-msg / system-result-msg /
  offer-msg / offer-reply-msg / resume-msg / resume-at-msg / cancel-msg / file-done-msg / file-data-msg /
  clip-offer-msg / clip-pull-msg / clip-data-msg / status-msg

; 0-RTT. The first message on the control stream from each side.
hello-msg = { type: "hello", id: uint, body: hello }
hello = {
  version: uint,
  name: tstr .size (1..64),
  ? addresses: [* tstr],    ; desktop: host:port it can be reached at, and "bt:AA:BB:CC:DD:EE:FF" for its
                            ; Bluetooth adapter; phone: "feature:..." entries, which older desktops ignore
}

pair-spake-msg = { type: "pair-spake", id: uint, body: pair-spake }
pair-spake = {
  ? method: "code" / "qr",  ; sent by the phone only
  msg: bstr .size 33,
}

pair-confirm-msg = { type: "pair-confirm", id: uint, body: { mac: bstr .size 32 } }

unpair-msg = { type: "unpair", id: uint, body: {} }

; Either side, once the session runs. At most 61440 bytes of UTF-8, so a share fits one frame. A link is an absolute
; http or https URL, scheme in any case, with no whitespace or control characters.
share-msg = { type: "share", id: uint, body: share }
share = text-share / link-share
text-share = { kind: "text", "text": tstr .size (1..61440) }
link-share = { kind: "link", "text": web-link }
web-link = sized-link .and link-pattern
sized-link = tstr .size (8..61440)
link-pattern = tstr .pcre "^[Hh][Tt][Tt][Pp][Ss]?://[^[:space:][:cntrl:]]+$"

; Sent when the share was handed to the receiver's surface.
share-ack-msg = { type: "share-ack", id: uint, body: { of: uint } }  ; of: the share's envelope id

; Files (ARCHITECTURE.md, Files). Either side sends; file ids are unique within an offer, and the offer fits one
; frame. The receiver sanitizes each name before using it.
transfer-id = bstr .size 16
offer-msg = { type: "offer", id: uint, body: offer }
offer = { transfer: transfer-id, files: [+ offered-file] }
offered-file = {
  id: uint,
  name: tstr .size (1..4096),
  size: uint,
  mime: tstr .size (1..255),
  sha256: bstr .size 32,
}

offer-reply-msg = { type: "offer-reply", id: uint, body: offer-reply }
offer-reply = accepted-reply / refused-reply
accepted-reply = { transfer: transfer-id, accepted: true }
refused-reply = { transfer: transfer-id, accepted: false, reason: "declined" / "no-space" / "too-large" / "busy" }

; Sent by the sender on a new session for each accepted, unfinished transfer.
resume-msg = { type: "resume", id: uint, body: { transfer: transfer-id } }
; Every unfinished file and where it continues; sent after a file-done for each finished one.
resume-at-msg = { type: "resume-at", id: uint, body: { transfer: transfer-id, offsets: [* file-offset] } }
file-offset = { file: uint, offset: uint }

cancel-msg = { type: "cancel", id: uint, body: { transfer: transfer-id } }

; The receiver's verdict on one file, after it verified the hash and published it (ok) or deleted it.
file-done-msg = { type: "file-done", id: uint, body: { transfer: transfer-id, file: uint, ok: bool } }

; The first frame of a file's unidirectional stream (envelope id 0); the bytes from offset to size follow.
file-data-msg = { type: "file-data", id: uint, body: { transfer: transfer-id, file: uint, offset: uint } }

; Clipboard (ARCHITECTURE.md, Clipboard). Either side; a new offer replaces the previous one. size is the length
; of the first type, at most 64 MiB; text is inline only when a text/plain type is offered. sizes, origin, and at
; only to a peer with feature:clip-items: each type's length in mimes order, the copy's random id (kept when a side
; offers a received clip on), and the copy time in ms since the Unix epoch.
clip-offer-msg = { type: "clip-offer", id: uint, body: clip-offer }
clip-offer = {
  id: uint,
  mimes: [1*16 media-type],
  size: uint .le 67108864,
  ? "text": tstr .size (1..61440),
  ? sizes: [1*16 uint .le 67108864],
  ? origin: uint,
  ? at: uint,
}

; Asks for one type of the latest offer; answered by a unidirectional stream opened with clip-data (envelope id 0),
; then the bytes, or reset at once for a stale offer.
clip-pull-msg = { type: "clip-pull", id: uint, body: clip-ref }
clip-data-msg = { type: "clip-data", id: uint, body: clip-ref }
clip-ref = { id: uint, mime: media-type }
media-type = tstr .size (1..255)

; Phone to desktop, on connect and on change, at most every 10 s.
status-msg = { type: "status", id: uint, body: status }
status = {
  battery: uint .le 100,    ; percent
  charging: bool,
  network: "wifi" / "cellular" / "ethernet" / "none" / "other",
  ? signal: uint .le 4,     ; cellular bars; absent without service
  ? notifications_off: true, ; notification access is off; only to desktops with feature:notification-sync
  ; Only to desktops with feature:system-control:
  ? media_volume: uint .le 100, ; percent
  ? ringer: "normal" / "vibrate" / "silent",
  ? dnd: bool,
  ? locked: bool,
}
; Phone to desktop. Sizes are bytes of UTF-8; not acknowledged.
notification-id = tstr .size (1..256)
notification-posted-msg = { type: "notification-posted", id: uint, body: notification-posted }
notification-posted = {
  "id": notification-id,
  app: tstr .size (1..128),
  title: tstr .size (0..512),
  "text": tstr .size (0..4096),
  ? icon: bstr .size (1..16384),   ; PNG
  actions: [0*3 notification-button],
  ? alert_once: true,              ; FLAG_ONLY_ALERT_ONCE; only to desktops with feature:notification-sync
}
notification-button = { "id": tstr .size (1..64), label: tstr .size (1..64), reply: bool }
notification-removed-msg = { type: "notification-removed", id: uint, body: { "id": notification-id } }

; Phone to desktop with feature:notification-sync, on connect: every notification on show. The desktop removes the
; ones missing and answers with notification-pull for new ones and ones whose hash differs.
; hash: FNV-1a 64 over the length-prefixed id, app, title, text, icon, then each action's id, label, reply byte.
notification-snapshot-msg = { type: "notification-snapshot", id: uint, body: notification-snapshot }
notification-snapshot = { notifications: [0*200 { "id": notification-id, hash: uint }] }
; Desktop to phone; the phone answers with notification-posted for each id it still shows.
notification-pull-msg = { type: "notification-pull", id: uint, body: { ids: [0*200 notification-id] } }

; Desktop to phone. reply_text only for an action whose reply is true.
notification-action-msg = { type: "notification-action", id: uint, body: notification-action }
notification-action = { "id": notification-id, action: tstr .size (1..64), ? reply_text: tstr .size (1..4096) }
notification-dismiss-msg = { type: "notification-dismiss", id: uint, body: { "id": notification-id } }

; Either side, about its own players (media-player, media-gone) or the other's (media-command); not acknowledged.
player-id = tstr .size (1..64)
media-command-kind = "play" / "pause" / "play-pause" / "next" / "previous" / "seek" / "volume"
media-player-msg = { type: "media-player", id: uint, body: media-player }
media-player = {
  player: player-id,
  name: tstr .size (1..64),
  state: "playing" / "paused" / "stopped",
  title: tstr .size (0..512),
  artist: tstr .size (0..512),
  album: tstr .size (0..512),
  ? length_ms: uint,
  position_ms: uint,                  ; when sent; the receiver advances it while playing
  ? volume: 0..100,
  ? artwork: bstr .size (1..49152),   ; PNG or JPEG
  can: [* media-command-kind],        ; each at most once
}
media-gone-msg = { type: "media-gone", id: uint, body: { player: player-id } }
media-command-msg = { type: "media-command", id: uint, body: media-command }
media-command = seek-command / volume-command / plain-command
seek-command = { player: player-id, command: "seek", value: uint }   ; the absolute position in ms
volume-command = { player: player-id, command: "volume", value: 0..100 }
plain-command = { player: player-id, command: "play" / "pause" / "play-pause" / "next" / "previous" }

; Either side. ring asks the receiver to start (true) or stop (false) ringing; ringing reports the sender's own.
ring-msg = { type: "ring", id: uint, body: { on: bool } }
ringing-msg = { type: "ringing", id: uint, body: { on: bool } }

; Phone to desktop: the call state as Android reports it. number only with READ_CALL_LOG, name only for a contact.
call-msg = { type: "call", id: uint, body: call-body }
call-body = {
  state: "ringing" / "active" / "idle",
  ? "number": tstr .size (1..64),   ; quoted: number is a CDDL prelude type
  ? name: tstr .size (1..128),
}
; Desktop to phone.
call-action-msg = { type: "call-action", id: uint, body: { action: "mute" / "decline" } }

; Over Bluetooth, to move a session to full speed. The desktop asks (hotspot-request); the phone starts a local-only
; hotspot and sends its credentials (hotspot); the desktop joins and says where it listens (hotspot-joined); either
; side ends it, with a reason when it failed (hotspot-end).
hotspot-request-msg = { type: "hotspot-request", id: uint, body: {} }
hotspot-msg = { type: "hotspot", id: uint, body: {
  ssid: tstr .size (1..32),
  passphrase: tstr .size (8..63),  ; printable ASCII
} }
hotspot-joined-msg = { type: "hotspot-joined", id: uint, body: { address: tstr } }  ; host:port
hotspot-end-msg = { type: "hotspot-end", id: uint, body: { ? reason: tstr .size (1..128) } }

; Wi-Fi Direct, tried before the hotspot so the desktop may keep its own network. A desktop whose hello lists
; "feature:wifi-direct-join" gets the credentials of a group the phone owns (wifi-direct) in place of hotspot ones,
; and answers as for a hotspot, with hotspot-joined (its own address on the group) or hotspot-end; a failed group
; falls back to the hotspot. Older desktops send wifi-direct-ready, which phones ignore.
wifi-direct-ready-msg = {
  type: "wifi-direct-ready", id: uint,
  body: { name: tstr .size (1..32), ? address: tstr .regexp "[0-9a-f]{2}(:[0-9a-f]{2}){5}" },
}
wifi-direct-msg = { type: "wifi-direct", id: uint, body: {
  ssid: tstr .size (1..32),
  passphrase: tstr .size (8..63),  ; printable ASCII
} }

; Pairing Bluetooth, which the desktop needs before it accepts a phone's connections over it. Phone to desktop,
; only when the desktop's hello listed "feature:bt-pairing": without passkey before Android starts pairing, so the
; desktop accepts the unpaired connection; with the six-digit code Android shows, which the desktop's pairing agent
; confirms against its own instead of asking.
bt-pairing-msg = { type: "bt-pairing", id: uint, body: { ? passkey: uint .le 999999 } }

; Mirroring the phone's screen, while the phone's screen switch for the desktop is on. The desktop asks
; (mirror-request, 0-RTT); the phone shows Android's capture prompt, then says the size (mirror-started) and opens a
; unidirectional stream whose header is mirror-data, followed by H.264 access units: u32 length, u64 presentation
; time in microseconds, a flags byte (1 keyframe, 2 codec configuration, 4 audio: one 48 kHz stereo Opus packet
; instead of video), then the bytes, at most 4 MiB. When the desktop's hello has feature:mirror-streams, that first
; stream carries only the sound, and each keyframe (codec configuration in front) opens a new stream whose mirror-data
; has gop, counting up from 1, with the video after it. The newest gop is the one shown: the phone finishes the one
; before (resetting it unless acknowledged within 250 ms) and the desktop stops reading older ones. The
; desktop sends input (coordinates in 1/10000 of the width and height; a scroll's x2, y2 is a signed delta) and asks
; for a keyframe after a loss (mirror-keyframe, 0-RTT). Either side ends it (mirror-stop).
mirror-request-msg = { type: "mirror-request", id: uint, body: {} }
mirror-started-msg = { type: "mirror-started", id: uint, body: { width: 1..4096, height: 1..4096 } }
; Phone to desktop after mirror-started and after each rotation, only when the desktop's hello has
; feature:screen-shape: rounded corners (top-left, top-right, bottom-right, bottom-left) and camera cutouts in the
; picture, in 1/10000 of its width (x, radii) or height (y).
screen-shape-msg = { type: "screen-shape", id: uint, body: { corners: [4*4 0..5000],
  cutouts: [0*4 { x: 0..9999, y: 0..9999, width: 1..10000, height: 1..10000 }] } }
mirror-stop-msg = { type: "mirror-stop", id: uint, body: { ? reason: tstr .size (1..128) } }
mirror-input-msg = { type: "mirror-input", id: uint, body: {
  action: "tap" / "long-press" / "swipe" / "scroll" / "back" / "home" / "recents" / "text" / "touch-down" /
    "touch-move" / "touch-up" / "wheel" / "key-down" / "key-up" / "screen-off" / "screen-on",
  ? x: 0..10000, ? y: 0..10000,
  ? x2: -10000..10000, ? y2: -10000..10000,
  ? ms: 0..10000,
  ? text: tstr .size (1..4096),
  ? code: 1..400, ? meta: uint,
} }
mirror-keyframe-msg = { type: "mirror-keyframe", id: uint, body: {} }
mirror-data-msg = { type: "mirror-data", id: uint, body: { width: 1..4096, height: 1..4096, ? gop: uint .ge 1 } }

; Phone to desktop, before dialling it from a Bluetooth session: the phone's own host:port pairs, which the desktop
; sends one UDP byte to so its firewall takes the dial for a reply.
punch-msg = { type: "punch", id: uint, body: { addresses: [0*8 tstr] } }

; The desktop browses the phone's storage, read-only, while the phone's browse switch for it is on. A path is "/" for
; the roots, else "/<root>/<name>/..." with no empty, ".", or ".." component. req pairs each answer with its request.
fs-path = tstr .size (1..4096)
fs-name = tstr .size (1..255)
fs-list-msg = { type: "fs-list", id: uint, body: { req: uint, path: fs-path, ? cursor: uint } }
fs-entries-msg = { type: "fs-entries", id: uint, body: {
  req: uint,
  entries: [* { name: fs-name, dir: bool, size: uint, mtime: uint }],  ; at most 128
  ? next: uint,
} }
fs-read-msg = { type: "fs-read", id: uint, body: { req: uint, path: fs-path, offset: uint, len: 1..1048576 } }
fs-data-msg = { type: "fs-data", id: uint, body: { req: uint, offset: uint, data: bstr .size (0..49152), ? last: true } }
; fs-stat is answered by fs-entries holding the one entry. fs-thumb is answered like fs-read from offset 0: a PNG at
; most px on its longer side, or fs-error not-found when the file has no picture.
fs-stat-msg = { type: "fs-stat", id: uint, body: { req: uint, path: fs-path } }
fs-thumb-msg = { type: "fs-thumb", id: uint, body: { req: uint, path: fs-path, px: 1..1024 } }
fs-error-msg = { type: "fs-error", id: uint, body: {
  req: uint,
  reason: "not-found" / "denied" / "not-allowed" / "not-a-folder" / "not-a-file" / "busy" / "io",
} }
; Writes, with "feature:fs-write" in the phone's hello, under the same switch and only inside a folder root, not Photos.
; fs-write puts data at offset in the file, and at offset 0 creates it (fs-error denied when the name is taken);
; fs-delete removes a file. fs-entries answers each: the file's entry after the write, none after the delete.
fs-write-msg = { type: "fs-write", id: uint, body: { req: uint, path: fs-path, offset: uint, data: bstr .size (0..49152) } }
fs-delete-msg = { type: "fs-delete", id: uint, body: { req: uint, path: fs-path } }

; A photo for the desktop, with "feature:camera" in the phone's hello and its browse switch on: the phone opens its
; camera, and once the user took the photo answers with its browse path under the Photos root, or with why not.
photo-request-msg = { type: "photo-request", id: uint, body: { req: uint } }
photo-taken-msg = { type: "photo-taken", id: uint, body: {
  req: uint,
  ? path: fs-path,
  ? refused: "not-allowed" / "denied" / "cancelled" / "failed",
} }

; Contacts, both sides with "feature:messages" in their hello. The desktop pulls them page by page on connect and after
; contacts-changed, which the phone sends when they or its messages switch change. A refused page has no contacts.
contacts-list-msg = { type: "contacts-list", id: uint, body: { req: uint, ? cursor: uint } }
contacts-msg = { type: "contacts", id: uint, body: {
  req: uint,
  contacts: [0*64 contact],
  ? next: uint,
  ? refused: "not-allowed" / "denied" / "failed",
} }
contact = { name: tstr .size (1..128), numbers: [0*8 tstr .size (1..64)] }
contacts-changed-msg = { type: "contacts-changed", id: uint, body: {} }

; Texts, behind the same switch: the desktop pulls the newest (at most 256) on connect and after texts-changed, which
; the phone sends when a text arrives, is sent, or the switch changes. date is in Unix milliseconds; sent marks one
; this phone sent. text-sent answers text-send once Android reports the text sent, or with why not.
texts-list-msg = { type: "texts-list", id: uint, body: { req: uint, ? cursor: uint } }
texts-msg = { type: "texts", id: uint, body: {
  req: uint,
  texts: [0*16 text],
  ? next: uint,
  ? refused: "not-allowed" / "denied" / "failed",
} }
text = {
  id: uint,
  thread: uint,
  address: tstr .size (1..64),
  body: tstr .size (0..2048),
  date: uint,
  sent: bool,
}
texts-changed-msg = { type: "texts-changed", id: uint, body: {} }
text-send-msg = { type: "text-send", id: uint, body: { req: uint, to: tstr .size (1..64), body: tstr .size (1..2048) } }
text-sent-msg = { type: "text-sent", id: uint, body: { req: uint, ? refused: "not-allowed" / "denied" / "failed" } }

; The call log and dialing, both sides with "feature:calls" in their hello, while the phone's calls switch for the
; desktop is on. The desktop pulls the newest (at most 256) on connect and after calls-changed, which the phone sends when
; its log or the switch changes. date is in Unix milliseconds, duration in seconds. dial places a call on the phone,
; whose audio stays there; dialed answers once Android took it, or with why not.
calls-list-msg = { type: "calls-list", id: uint, body: { req: uint, ? cursor: uint } }
calls-msg = { type: "calls", id: uint, body: {
  req: uint,
  calls: [0*64 logged-call],
  ? next: uint,
  ? refused: "not-allowed" / "denied" / "failed",
} }
logged-call = {
  "number": tstr .size (1..64),
  ? name: tstr .size (1..128),
  date: uint,
  duration: uint,
  kind: "incoming" / "outgoing" / "missed",
}
calls-changed-msg = { type: "calls-changed", id: uint, body: {} }
dial-msg = { type: "dial", id: uint, body: { req: uint, "number": tstr .regexp "[0-9+*#]{1,64}" } }
dialed-msg = { type: "dialed", id: uint, body: { req: uint, ? refused: "not-allowed" / "denied" / "failed" } }

; The phone as the desktop's remote, only when both hellos listed "feature:control". Phone to desktop, while the
; desktop's input switch for the phone is on: the pointer and keyboard, moves and scrolls in logical pixels. Desktop to
; phone, on connect and after each change: every command the phone may run, none without the desktop's commands
; switch; the phone runs one by id. Either way, without a switch: a ping the user sent, shown as a notification.
remote-input-msg = { type: "remote-input", id: uint, body: {
  action: "move" / "point" / "scroll" / "press" / "release" / "click" / "key" / "text",  ; point: dx, dy in 0..10000
  ? dx: -10000..10000, ? dy: -10000..10000,
  ? button: "left" / "right" / "middle",
  ? key: "enter" / "backspace" / "delete" / "escape" / "tab" / "space" / "left" / "right" / "up" / "down" / "home" /
    "end" / "page-up" / "page-down" / "f5",
  ? "text": tstr .size (1..4096),  ; quoted: a bare text is the prelude type
} }
commands-msg = { type: "commands", id: uint, body: {
  commands: [* { id: tstr .size (1..64), name: tstr .size (1..512) }],  ; at most 64
} }
run-command-msg = { type: "run-command", id: uint, body: { id: tstr .size (1..64) } }
; Remote control, under the same input switch, only over the same network: the phone asks for the desktop's screen, or
; to switch to one of the sources (remote-request). The desktop lists the monitors and windows its user shared, and
; which one shows (remote-started), then opens a mirror-data stream to the phone, in mirroring's framing, with the
; desktop's sound as audio units; a switch opens a new stream. remote-input "point" puts the pointer at a fraction of
; the picture. Either side ends it (remote-stop).
remote-request-msg = { type: "remote-request", id: uint, body: { ? source: uint .le 15 } }
remote-started-msg = { type: "remote-started", id: uint, body: {
  sources: [1*16 { kind: "monitor" / "window", name: tstr .size (1..128) }],
  current: uint .le 15,
} }
remote-stop-msg = { type: "remote-stop", id: uint, body: { ? reason: tstr .size (1..128) } }
ping-msg = { type: "ping", id: uint, body: { ? message: tstr .size (1..256) } }
; Phone to desktop, with "feature:presenting" in the desktop's hello and the desktop's input switch on: the phone's presenter
; opened (true) or closed (false). The desktop keeps itself awake while one is open, as while a phone mirrors.
presenting-msg = { type: "presenting", id: uint, body: { on: bool } }

; Desktop to phone, only when both hellos listed "feature:capabilities"; on connect and after each change: what the
; desktop's session can do now ("clipboard", "input", "notifications", "volume"). The phone hides the rest and skips
; entries it does not know.
capabilities-msg = { type: "capabilities", id: uint, body: { can: [* tstr .size (1..32)] } }  ; at most 16

; Only when both hellos listed "feature:system". Desktop to phone, on connect and after each change: the desktop's
; state. A command goes either way while the receiver's system switch for the sender is on; the desktop sends only
; set-media-volume, set-ringer and set-dnd. Fields after muted, commands after set-mute, and system-result only when
; both hellos also listed "feature:system-control". Volume and brightness changes go at most every 150 ms.
desktop-status-msg = { type: "desktop-status", id: uint, body: desktop-status }
; volume and muted are absent only without a volume control, and then only to a phone with feature:system-control.
desktop-status = {
  ? volume: uint .le 100,   ; percent
  ? muted: bool,
  ? battery: uint .le 100,  ; percent; absent without a battery
  ? charging: bool,
  ? brightness: uint .le 100, ; percent; absent without a backlight
  ? locked: bool,
  ? idle: bool,
  ? dnd: bool,
  ? profile: "power-saver" / "balanced" / "performance",
}
system-command-msg = { type: "system-command", id: uint, body:
  { command: "set-volume" / "set-brightness" / "set-media-volume", value: uint .le 100 } /
  { command: "set-mute" / "set-dnd", value: 0 / 1 } /
  { command: "set-profile", value: 0 / 1 / 2 } /  ; power-saver, balanced, performance
  { command: "set-ringer", value: 0 / 1 / 2 } /   ; silent, vibrate, normal
  { command: "lock" / "suspend" / "screen-off" }
}
; The answer to the system-command whose message id is command; error, for the user, when it was not done.
system-result-msg = { type: "system-result", id: uint, body: { command: uint, ? error: tstr .size (1..200) } }
