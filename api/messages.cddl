; Link v1 control messages. A frame is a big-endian u32 length, then one CBOR envelope of at most 64 KiB.
; Types marked "0-RTT" are idempotent and may be sent in QUIC early data.

envelope = hello-msg / pair-spake-msg / pair-confirm-msg / unpair-msg / share-msg / share-ack-msg /
  notification-posted-msg / notification-removed-msg / notification-action-msg / notification-dismiss-msg /
  media-player-msg / media-gone-msg / media-command-msg / ring-msg / ringing-msg / call-msg / call-action-msg /
  hotspot-request-msg / hotspot-msg / hotspot-joined-msg / hotspot-end-msg / punch-msg /
  wifi-direct-ready-msg / wifi-direct-msg / bt-pairing-msg /
  mirror-request-msg / mirror-started-msg / mirror-stop-msg / mirror-input-msg / mirror-keyframe-msg / mirror-data-msg /
  fs-list-msg / fs-entries-msg / fs-read-msg / fs-data-msg / fs-error-msg /
  offer-msg / offer-reply-msg / resume-msg / resume-at-msg / cancel-msg / file-done-msg / file-data-msg /
  clip-offer-msg / clip-pull-msg / clip-data-msg / status-msg

; 0-RTT. The first message on the control stream from each side.
hello-msg = { type: "hello", id: uint, body: hello }
hello = {
  version: uint,
  name: tstr .size (1..64),
  ? addresses: [* tstr],    ; desktop: host:port it can be reached at, and "bt:AA:BB:CC:DD:EE:FF" for its
                            ; Bluetooth adapter; phone: "feature:..." entries, which older desktops ignore
}

pair-spake-msg = { type: "pair-spake", id: uint, body: pair-spake }
pair-spake = {
  ? method: "code" / "qr",  ; sent by the phone only
  msg: bstr .size 33,
}

pair-confirm-msg = { type: "pair-confirm", id: uint, body: { mac: bstr .size 32 } }

unpair-msg = { type: "unpair", id: uint, body: {} }

; Either side, once the session runs. At most 61440 bytes of UTF-8, so a share fits one frame. A link is an absolute
; http or https URL, scheme in any case, with no whitespace or control characters.
share-msg = { type: "share", id: uint, body: share }
share = text-share / link-share
text-share = { kind: "text", "text": tstr .size (1..61440) }
link-share = { kind: "link", "text": web-link }
web-link = sized-link .and link-pattern
sized-link = tstr .size (8..61440)
link-pattern = tstr .pcre "^[Hh][Tt][Tt][Pp][Ss]?://[^[:space:][:cntrl:]]+$"

; Sent when the share was handed to the receiver's surface.
share-ack-msg = { type: "share-ack", id: uint, body: { of: uint } }  ; of: the share's envelope id

; Files (ARCHITECTURE.md, Files). Either side sends; file ids are unique within an offer, and the offer fits one
; frame. The receiver sanitizes each name before using it.
transfer-id = bstr .size 16
offer-msg = { type: "offer", id: uint, body: offer }
offer = { transfer: transfer-id, files: [+ offered-file] }
offered-file = {
  id: uint,
  name: tstr .size (1..4096),
  size: uint,
  mime: tstr .size (1..255),
  sha256: bstr .size 32,
}

offer-reply-msg = { type: "offer-reply", id: uint, body: offer-reply }
offer-reply = accepted-reply / refused-reply
accepted-reply = { transfer: transfer-id, accepted: true }
refused-reply = { transfer: transfer-id, accepted: false, reason: "declined" / "no-space" / "too-large" / "busy" }

; Sent by the sender on a new session for each accepted, unfinished transfer.
resume-msg = { type: "resume", id: uint, body: { transfer: transfer-id } }
; Every unfinished file and where it continues; sent after a file-done for each finished one.
resume-at-msg = { type: "resume-at", id: uint, body: { transfer: transfer-id, offsets: [* file-offset] } }
file-offset = { file: uint, offset: uint }

cancel-msg = { type: "cancel", id: uint, body: { transfer: transfer-id } }

; The receiver's verdict on one file, after it verified the hash and published it (ok) or deleted it.
file-done-msg = { type: "file-done", id: uint, body: { transfer: transfer-id, file: uint, ok: bool } }

; The first frame of a file's unidirectional stream (envelope id 0); the bytes from offset to size follow.
file-data-msg = { type: "file-data", id: uint, body: { transfer: transfer-id, file: uint, offset: uint } }

; Clipboard (ARCHITECTURE.md, Clipboard). Either side; a new offer replaces the previous one. size is the length
; of the first type, at most 64 MiB; text is inline only when a text/plain type is offered.
clip-offer-msg = { type: "clip-offer", id: uint, body: clip-offer }
clip-offer = {
  id: uint,
  mimes: [1*16 media-type],
  size: uint .le 67108864,
  ? "text": tstr .size (1..61440),
}

; Asks for one type of the latest offer; answered by a unidirectional stream opened with clip-data (envelope id 0),
; then the bytes, or reset at once for a stale offer.
clip-pull-msg = { type: "clip-pull", id: uint, body: clip-ref }
clip-data-msg = { type: "clip-data", id: uint, body: clip-ref }
clip-ref = { id: uint, mime: media-type }
media-type = tstr .size (1..255)

; Phone to desktop, on connect and on change, at most every 10 s.
status-msg = { type: "status", id: uint, body: status }
status = {
  battery: uint .le 100,    ; percent
  charging: bool,
  network: "wifi" / "cellular" / "ethernet" / "none" / "other",
}
; Phone to desktop. Sizes are bytes of UTF-8; not acknowledged.
notification-id = tstr .size (1..256)
notification-posted-msg = { type: "notification-posted", id: uint, body: notification-posted }
notification-posted = {
  "id": notification-id,
  app: tstr .size (1..128),
  title: tstr .size (0..512),
  "text": tstr .size (0..4096),
  ? icon: bstr .size (1..16384),   ; PNG
  actions: [0*3 notification-button],
}
notification-button = { "id": tstr .size (1..64), label: tstr .size (1..64), reply: bool }
notification-removed-msg = { type: "notification-removed", id: uint, body: { "id": notification-id } }

; Desktop to phone. reply_text only for an action whose reply is true.
notification-action-msg = { type: "notification-action", id: uint, body: notification-action }
notification-action = { "id": notification-id, action: tstr .size (1..64), ? reply_text: tstr .size (1..4096) }
notification-dismiss-msg = { type: "notification-dismiss", id: uint, body: { "id": notification-id } }

; Either side, about its own players (media-player, media-gone) or the other's (media-command); not acknowledged.
player-id = tstr .size (1..64)
media-command-kind = "play" / "pause" / "play-pause" / "next" / "previous" / "seek" / "volume"
media-player-msg = { type: "media-player", id: uint, body: media-player }
media-player = {
  player: player-id,
  name: tstr .size (1..64),
  state: "playing" / "paused" / "stopped",
  title: tstr .size (0..512),
  artist: tstr .size (0..512),
  album: tstr .size (0..512),
  ? length_ms: uint,
  position_ms: uint,                  ; when sent; the receiver advances it while playing
  ? volume: 0..100,
  ? artwork: bstr .size (1..49152),   ; PNG or JPEG
  can: [* media-command-kind],        ; each at most once
}
media-gone-msg = { type: "media-gone", id: uint, body: { player: player-id } }
media-command-msg = { type: "media-command", id: uint, body: media-command }
media-command = seek-command / volume-command / plain-command
seek-command = { player: player-id, command: "seek", value: uint }   ; the absolute position in ms
volume-command = { player: player-id, command: "volume", value: 0..100 }
plain-command = { player: player-id, command: "play" / "pause" / "play-pause" / "next" / "previous" }

; Either side. ring asks the receiver to start (true) or stop (false) ringing; ringing reports the sender's own.
ring-msg = { type: "ring", id: uint, body: { on: bool } }
ringing-msg = { type: "ringing", id: uint, body: { on: bool } }

; Phone to desktop: the call state as Android reports it. number only with READ_CALL_LOG, name only for a contact.
call-msg = { type: "call", id: uint, body: call-body }
call-body = {
  state: "ringing" / "active" / "idle",
  ? "number": tstr .size (1..64),   ; quoted: number is a CDDL prelude type
  ? name: tstr .size (1..128),
}
; Desktop to phone.
call-action-msg = { type: "call-action", id: uint, body: { action: "mute" / "decline" } }

; Over Bluetooth, to move a session to full speed. The desktop asks (hotspot-request); the phone starts a local-only
; hotspot and sends its credentials (hotspot); the desktop joins and says where it listens (hotspot-joined); either
; side ends it, with a reason when it failed (hotspot-end).
hotspot-request-msg = { type: "hotspot-request", id: uint, body: {} }
hotspot-msg = { type: "hotspot", id: uint, body: {
  ssid: tstr .size (1..32),
  passphrase: tstr .size (8..63),  ; printable ASCII
} }
hotspot-joined-msg = { type: "hotspot-joined", id: uint, body: { address: tstr } }  ; host:port
hotspot-end-msg = { type: "hotspot-end", id: uint, body: { ? reason: tstr .size (1..128) } }

; Wi-Fi Direct, tried before the hotspot so the desktop keeps its own network. On connect, a desktop that can join a
; group says so with the name it shows while looking (wifi-direct-ready), and its P2P device address for a phone whose
; hello listed "feature:wifi-direct-address" (wpa_supplicant shows no name by default; older phones close a session on
; the unknown field). The phone forms the group, in either role, and sends its own name (wifi-direct) in place of
; hotspot credentials; the desktop answers as for a hotspot, with hotspot-joined (its own address on the group) or
; hotspot-end, and a failed group falls back to the hotspot.
wifi-direct-ready-msg = {
  type: "wifi-direct-ready", id: uint,
  body: { name: tstr .size (1..32), ? address: tstr .regexp "[0-9a-f]{2}(:[0-9a-f]{2}){5}" },
}
wifi-direct-msg = { type: "wifi-direct", id: uint, body: { name: tstr .size (1..32) } }

; Pairing Bluetooth, which the desktop needs before it accepts a phone's connections over it. Phone to desktop,
; only when the desktop's hello listed "feature:bt-pairing": without passkey before Android starts pairing, so the
; desktop accepts the unpaired connection; with the six-digit code Android shows, which the desktop's pairing agent
; confirms against its own instead of asking.
bt-pairing-msg = { type: "bt-pairing", id: uint, body: { ? passkey: uint .le 999999 } }

; Mirroring the phone's screen, while the phone's screen switch for the desktop is on. The desktop asks
; (mirror-request, 0-RTT); the phone shows Android's capture prompt, then says the size (mirror-started) and opens a
; unidirectional stream whose header is mirror-data, followed by H.264 access units: u32 length, u64 presentation
; time in microseconds, a flags byte (1 keyframe, 2 codec configuration), then Annex B bytes of at most 4 MiB. The
; desktop sends input (coordinates in 1/10000 of the width and height; a scroll's x2, y2 is a signed delta) and asks
; for a keyframe after a loss (mirror-keyframe, 0-RTT). Either side ends it (mirror-stop).
mirror-request-msg = { type: "mirror-request", id: uint, body: {} }
mirror-started-msg = { type: "mirror-started", id: uint, body: { width: 1..4096, height: 1..4096 } }
mirror-stop-msg = { type: "mirror-stop", id: uint, body: { ? reason: tstr .size (1..128) } }
mirror-input-msg = { type: "mirror-input", id: uint, body: {
  action: "tap" / "long-press" / "swipe" / "scroll" / "back" / "home" / "recents" / "text",
  ? x: 0..10000, ? y: 0..10000,
  ? x2: -10000..10000, ? y2: -10000..10000,
  ? ms: 0..10000,
  ? text: tstr .size (1..4096),
} }
mirror-keyframe-msg = { type: "mirror-keyframe", id: uint, body: {} }
mirror-data-msg = { type: "mirror-data", id: uint, body: { width: 1..4096, height: 1..4096 } }

; Phone to desktop, before dialling it from a Bluetooth session: the phone's own host:port pairs, which the desktop
; sends one UDP byte to so its firewall takes the dial for a reply.
punch-msg = { type: "punch", id: uint, body: { addresses: [0*8 tstr] } }

; The desktop browses the phone's storage, read-only, while the phone's browse switch for it is on. A path is "/" for
; the roots, else "/<root>/<name>/..." with no empty, ".", or ".." component. req pairs each answer with its request.
fs-path = tstr .size (1..4096)
fs-name = tstr .size (1..255)
fs-list-msg = { type: "fs-list", id: uint, body: { req: uint, path: fs-path, ? cursor: uint } }
fs-entries-msg = { type: "fs-entries", id: uint, body: {
  req: uint,
  entries: [* { name: fs-name, dir: bool, size: uint, mtime: uint }],  ; at most 128
  ? next: uint,
} }
fs-read-msg = { type: "fs-read", id: uint, body: { req: uint, path: fs-path, offset: uint, len: 1..1048576 } }
fs-data-msg = { type: "fs-data", id: uint, body: { req: uint, offset: uint, data: bstr .size (0..49152), ? last: true } }
fs-error-msg = { type: "fs-error", id: uint, body: {
  req: uint,
  reason: "not-found" / "denied" / "not-allowed" / "not-a-folder" / "not-a-file" / "busy" / "io",
} }
