<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Served by umbriel-linkd on the session bus at /org/umbriel/Link1. -->
<node>
  <interface name="org.umbriel.Link1">
    <!-- Opens a 120 s pairing window accepting one attempt; replaces an open window. -->
    <method name="StartPairing">
      <arg name="code" type="s" direction="out"/>
      <arg name="uri" type="s" direction="out"/>
    </method>
    <method name="CancelPairing"/>
    <!-- The device is told at its next contact. -->
    <method name="Unpair">
      <arg name="device_id" type="s" direction="in"/>
    </method>
    <!-- Sends text or a link (kind "text" or "link") to a connected device; returns once it acknowledged.
         Errors: org.umbriel.Link1.Error.NotConnected without a live session, .Rejected for a share that breaks
         the rules in messages.cddl, .Failed when the device did not acknowledge it. -->
    <method name="Share">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="kind" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
    </method>
    <!-- Offers files to a connected device, or to a Nearby LocalSend device (localsend:<fingerprint>), and returns
         the transfer id (32 hex digits) at once; the Transfer* signals report the rest. Each entry is an open descriptor of a regular file and the name the device sees.
         Errors: .NotConnected without a live session, .Rejected for no files or a descriptor that is not a regular
         file, .Failed otherwise, including "too large to send over Bluetooth" and "hotspot: <reason>" when the device
         is on Bluetooth and its hotspot could not carry the files. Over Bluetooth, files past 20 MiB wait up to 60 s
         for the session to move to the phone's hotspot before this returns. -->
    <method name="SendFiles">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="files" type="a(hs)" direction="in"/>
      <arg name="transfer_id" type="s" direction="out"/>
    </method>
    <!-- Lists a folder on a connected phone whose browse switch for this desktop is on: "/" for its roots, else
         "/<root>/...". Each entry is (name, is_folder, size, mtime in Unix seconds), in name order, hidden entries
         left out. Errors: .Refused with the phone's reason (not-found, not-allowed, denied, not-a-folder,
         not-a-file, busy, io), .NotConnected, .Rejected for a malformed path, .Failed when the phone does not
         answer within 15 s. -->
    <method name="ListFiles">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
      <arg name="entries" type="a(sbtt)" direction="out"/>
    </method>
    <!-- Up to length bytes (1 byte to 1 MiB) of a file on a connected phone from offset; fewer at its end, none
         past it. Errors as ListFiles. -->
    <method name="ReadFile">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="path" type="s" direction="in"/>
      <arg name="offset" type="t" direction="in"/>
      <arg name="length" type="u" direction="in"/>
      <arg name="data" type="ay" direction="out"/>
    </method>
    <!-- Consent for a TransferOffered; .Rejected once the offer no longer waits (answered, withdrawn, or 120 s
         passed, which declines it). -->
    <method name="AcceptTransfer">
      <arg name="transfer_id" type="s" direction="in"/>
    </method>
    <method name="DeclineTransfer">
      <arg name="transfer_id" type="s" direction="in"/>
    </method>
    <!-- Either direction; the device is told and partial files are deleted. -->
    <method name="CancelTransfer">
      <arg name="transfer_id" type="s" direction="in"/>
    </method>
    <!-- Accept this device's offers without a TransferOffered. Off for a newly paired device. -->
    <method name="SetAutoAccept">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <!-- feature: clipboard, files, or notifications. A paired device starts with clipboard and files. -->
    <method name="SetGrant">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="feature" type="s" direction="in"/>
      <arg name="granted" type="b" direction="in"/>
    </method>
    <!-- The desktop's clipboard changed: offers it to connected devices holding the clipboard grant. data holds the
         first type's bytes (a memfd); text goes inline, anything else only when a device pulls it. -->
    <method name="OfferClipboard">
      <arg name="mimes" type="as" direction="in"/>
      <arg name="data" type="h" direction="in"/>
    </method>
    <!-- Writes type mime of a device's ClipboardOffered clip into sink (a paste target's pipe) and returns the byte
         count. Errors: .NotConnected, .Failed (a stale offer, a timeout, bytes past the offered size). -->
    <method name="PullClipboard">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="id" type="t" direction="in"/>
      <arg name="mime" type="s" direction="in"/>
      <arg name="sink" type="h" direction="in"/>
      <arg name="bytes" type="t" direction="out"/>
    </method>
    <!-- "Visible to LocalSend": answers LocalSend discovery and accepts LocalSend offers (with the same consent as
         Link), and lists LocalSend devices in Nearby. Off until turned on; kept across restarts. -->
    <method name="SetLocalSendVisible">
      <arg name="visible" type="b" direction="in"/>
    </method>
    <property name="LocalSendVisible" type="b" access="read"/>
    <!-- LocalSend devices on the LAN, (localsend:<fingerprint>, alias), while LocalSendVisible is on. -->
    <property name="Nearby" type="a(ss)" access="read"/>
    <!-- (device_id, name, connected) -->
    <property name="Devices" type="a(ssb)" access="read"/>
    <!-- Devices whose offers are accepted without asking. -->
    <property name="AutoAccept" type="as" access="read"/>
    <!-- Connected device id to (battery percent, charging, network); network is wifi, cellular, ethernet, none, or
         other. A device appears once it reported, and leaves when it disconnects. -->
    <property name="DeviceStatus" type="a{s(ubs)}" access="read"/>
    <!-- Device id to the features it holds. -->
    <property name="Grants" type="a{sas}" access="read"/>
    <property name="Pairing" type="b" access="read"/>
    <signal name="PairingFinished">
      <arg name="device_id" type="s"/>
      <arg name="name" type="s"/>
    </signal>
    <signal name="PairingFailed">
      <arg name="reason" type="s"/>
    </signal>
    <!-- A device shared text or a link, already checked against messages.cddl. -->
    <signal name="Received">
      <arg name="device_id" type="s"/>
      <arg name="kind" type="s"/>
      <arg name="text" type="s"/>
    </signal>
    <!-- A device offers files, each (sanitized name, size in bytes); answer with AcceptTransfer or DeclineTransfer.
         device_id is a Link device or localsend:<fingerprint>. -->
    <signal name="TransferOffered">
      <arg name="transfer_id" type="s"/>
      <arg name="device_id" type="s"/>
      <arg name="files" type="a(st)"/>
    </signal>
    <!-- Bytes moved so far in either direction, at most 4 times a second per transfer. -->
    <signal name="TransferProgress">
      <arg name="transfer_id" type="s"/>
      <arg name="bytes" type="t"/>
      <arg name="total" type="t"/>
    </signal>
    <!-- status: done, failed, declined, no-space, too-large, busy, or cancelled. paths: what an incoming transfer
         published in the download directory, each verified against its SHA-256. -->
    <signal name="TransferFinished">
      <arg name="transfer_id" type="s"/>
      <arg name="status" type="s"/>
      <arg name="paths" type="as"/>
    </signal>
    <!-- A device's clipboard changed; offer it as a selection and pull a type with PullClipboard on paste. size is the
         first type's length. -->
    <signal name="ClipboardOffered">
      <arg name="device_id" type="s"/>
      <arg name="id" type="t"/>
      <arg name="mimes" type="as"/>
      <arg name="size" type="t"/>
    </signal>
    <!-- Runs a phone notification's action; reply_text is empty for an action that takes none. Returns once sent,
         unacknowledged. Errors: .NotConnected, .Rejected for arguments over the limits in messages.cddl. -->
    <method name="NotificationAction">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="action" type="s" direction="in"/>
      <arg name="reply_text" type="s" direction="in"/>
    </method>
    <!-- The user dismissed a phone notification on the desktop; the phone cancels it. Errors as NotificationAction. -->
    <method name="NotificationDismiss">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- A phone notification to show, or a change to one on show (same id). icon is PNG, empty when absent;
         actions are (id, label, reply), reply meaning the action takes text. An identical re-post is not signalled. -->
    <signal name="NotificationPosted">
      <arg name="device_id" type="s"/>
      <arg name="id" type="s"/>
      <arg name="app" type="s"/>
      <arg name="title" type="s"/>
      <arg name="text" type="s"/>
      <arg name="icon" type="ay"/>
      <arg name="actions" type="a(ssb)"/>
    </signal>
    <!-- action is "mute" (silence the ringer until the call ends) or "decline" (end the ringing call). Returns once sent.
         Errors: .NotConnected, .Rejected for another action. -->
    <method name="CallAction">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="action" type="s" direction="in"/>
    </method>
    <!-- The phone's call state changed: state is "ringing", "active", or "idle"; number and name are empty when the
         phone may not read them. -->
    <signal name="Call">
      <arg name="device_id" type="s"/>
      <arg name="state" type="s"/>
      <arg name="number" type="s"/>
      <arg name="name" type="s"/>
    </signal>
    <!-- Starts (true) or stops ringing the phone. Returns once sent. Errors: .NotConnected. -->
    <method name="Ring">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="on" type="b" direction="in"/>
    </method>
    <!-- The desktop started or stopped ringing for the phone that asked; the phone shows it. Errors: .NotConnected. -->
    <method name="DesktopRinging">
      <arg name="device_id" type="s" direction="in"/>
      <arg name="on" type="b" direction="in"/>
    </method>
    <!-- The phone asks this desktop to ring (true) or to stop. -->
    <signal name="RingRequested">
      <arg name="device_id" type="s"/>
      <arg name="on" type="b"/>
    </signal>
    <!-- This desktop joined the phone's hotspot ssid to move a transfer off Bluetooth, which takes it off its own
         Wi-Fi; an empty ssid means it left and NetworkManager is bringing the usual network back. -->
    <signal name="Hotspot">
      <arg name="device_id" type="s"/>
      <arg name="ssid" type="s"/>
    </signal>
    <!-- The phone's own ringing started or stopped, for any reason. -->
    <signal name="PhoneRinging">
      <arg name="device_id" type="s"/>
      <arg name="on" type="b"/>
    </signal>
    <!-- A phone notification is gone: removed on the phone, displaced by the 64-per-device limit, or its device
         unpaired. -->
    <signal name="NotificationRemoved">
      <arg name="device_id" type="s"/>
      <arg name="id" type="s"/>
    </signal>
  </interface>
  <!-- Quick Share with nearby Android devices, on the same object. Hidden until Visible is set; every offer waits for
       Accept or Decline (60 s, then declined). -->
  <interface name="org.umbriel.Link1.QuickShare">
    <property name="Visible" type="b" access="readwrite"/>
    <!-- The name nearby devices see. -->
    <property name="Name" type="s" access="read"/>
    <method name="Accept">
      <arg name="id" type="t" direction="in"/>
    </method>
    <method name="Decline">
      <arg name="id" type="t" direction="in"/>
    </method>
    <!-- Browses for nearby receivers and sends the BLE hint Android needs, until StopDiscovery. -->
    <method name="StartDiscovery"/>
    <method name="StopDiscovery"/>
    <!-- files: (descriptor, name); the daemon never opens paths. Returns the id SendPin and SendFinished carry. -->
    <method name="Send">
      <arg name="peer" type="s" direction="in"/>
      <arg name="files" type="a(hs)" direction="in"/>
      <arg name="id" type="t" direction="out"/>
    </method>
    <!-- (id, name) of receivers found since StartDiscovery. -->
    <property name="Nearby" type="a(ss)" access="read"/>
    <signal name="SendPin">
      <arg name="id" type="t"/>
      <arg name="peer" type="s"/>
      <arg name="pin" type="s"/>
    </signal>
    <!-- status: sent, declined, or failed. -->
    <signal name="SendFinished">
      <arg name="id" type="t"/>
      <arg name="status" type="s"/>
      <arg name="error" type="s"/>
    </signal>
    <!-- files: (name, size); texts: kinds of shared text (text, url, address, phone). -->
    <signal name="Offer">
      <arg name="id" type="t"/>
      <arg name="sender" type="s"/>
      <arg name="pin" type="s"/>
      <arg name="files" type="a(sx)"/>
      <arg name="texts" type="as"/>
    </signal>
    <!-- status: received, declined, cancelled, or failed; files: saved paths; texts: (kind, text). -->
    <signal name="Finished">
      <arg name="id" type="t"/>
      <arg name="status" type="s"/>
      <arg name="files" type="as"/>
      <arg name="texts" type="a(ss)"/>
      <arg name="error" type="s"/>
    </signal>
  </interface>
</node>
