    <string name="onboarding_notifications_title">Notifications on your desktop</string>
    <string name="onboarding_notifications_body">Notification access lets your desktop show this phone\'s notifications and send back replies and actions. It also lets desktops control what this phone plays.</string>
    <string name="onboarding_dnd_title">Ring through Do Not Disturb</string>
    <string name="onboarding_dnd_body">Find my phone rings at full volume even on silent. On Android 14 and earlier this grant also lets it ring through Do Not Disturb; later versions let alarms through unless you blocked them.</string>
    <string name="onboarding_post_title">Shares and alerts</string>
    <string name="onboarding_post_body">Links and text your desktop sends, and the ringing alert, arrive as notifications.</string>
    <string name="onboarding_battery_title">Stay connected all day</string>
    <string name="onboarding_battery_body">Android stops background apps to save battery. Exempting Umbriel Link keeps Stay connected running, so your desktop can reach this phone at any time. It uses little power: the connection is idle between messages.</string>
    <string name="onboarding_calls_title">Calls on your desktop</string>
    <string name="onboarding_calls_body">See who is calling on your desktop and mute or decline from there. The caller\'s name needs contacts, and declining needs call control.</string>
