    <string name="connected_bluetooth">Connected over Bluetooth</string>
    <string name="onboarding_bluetooth_title">Stay connected without Wi-Fi</string>
    <string name="onboarding_bluetooth_body">When your phone and desktop aren\'t on the same Wi-Fi, Link talks over Bluetooth instead: messages, the clipboard, notifications, and calls. For bigger files it starts a private hotspot the desktop joins for a moment; it uses no mobile data. Android asks once for nearby devices.</string>
    <string name="clipboard_sent">On %1$s\'s clipboard</string>
    <string name="clipboard_queued">Will send when %1$s connects</string>
    <string name="onboarding_texts_title">Texts on your desktop</string>
    <string name="onboarding_texts_body">Optional. Read and answer this phone\'s texts from your desktop. Link reads them only for a desktop whose Contacts and texts switch is on, and sends a text only when you send it there.</string>
    <string name="onboarding_clipboard_title">Copy here, paste there</string>
    <string name="onboarding_clipboard_body">Optional. Android lets only a few apps notice what you copy. With these two allowances, anything you copy on this phone lands on your desktop\'s clipboard by itself. Without them, the Clipboard button on Home, the quick settings tile, or the Stay connected notification sends it in one tap. With Shizuku or root, Android asks nothing more. With the computer command, Android asks to allow access to device logs: tap Allow. On OnePlus, OPPO, and realme, turn on Disable permission monitoring in Developer options before running the command.</string>
    <string name="onboarding_clipboard_step_overlay">Display over other apps</string>
    <string name="onboarding_clipboard_step_logs">Log access: Shizuku, root, or once from a computer</string>
    <string name="onboarding_clipboard_shizuku">Use Shizuku</string>
    <string name="onboarding_clipboard_copy">Copy the command</string>
    <string name="onboarding_clipboard_open">Open</string>
    <string name="onboarding_clipboard_restricted">Switch greyed out? Android limits this for apps installed outside a store: in App info, open the ⋮ menu and choose Allow restricted settings, then come back.</string>
