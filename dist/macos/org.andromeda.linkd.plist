<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Link service as a per-user launchd agent, in ~/Library/LaunchAgents. It serves org.andromeda.Link1 on
     ~/Library/Application Support/Andromeda Link/link.sock. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.andromeda.linkd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Andromeda Link.app/Contents/MacOS/andromeda-linkd</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
