[Unit]
Description=Umbriel Link, connected phones' files at ~/Phone
PartOf=umbriel-session.target
After=umbriel-session.target umbriel-linkd.service
Wants=umbriel-linkd.service

[Service]
Slice=background.slice
ExecStart=/usr/bin/umbriel-link-mount
Restart=on-failure
# No sandboxing: in a user unit it implies NoNewPrivileges and a private mount namespace, so the setuid fusermount3
# could not mount and nothing it mounted would be seen. It parses no network input, only the daemon's D-Bus answers.

[Install]
WantedBy=umbriel-session.target
