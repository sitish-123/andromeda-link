# Phones reach the daemon only through the firewall; open it where ufw is running, as the profile describes.
post_install() {
  command -v ufw > /dev/null || return 0
  ufw status 2> /dev/null | grep -q '^Status: active' || return 0
  if ufw allow 'Umbriel Link' > /dev/null 2>&1; then
    echo ':: ufw: allowed Umbriel Link (4717/udp, 4718/tcp, 5353/udp)'
  else
    echo ":: ufw: could not allow Umbriel Link; phones cannot pair until you run: sudo ufw allow 'Umbriel Link'"
  fi
}

post_upgrade() {
  post_install
}
